{
  "name": "@built-in-ai-obs/devtools-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome DevTools extension for zero-code Built-in AI tracing",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@built-in-ai-obs/core": "workspace:*",
    "@built-in-ai-obs/extension-transport": "workspace:*",
    "@built-in-ai-obs/instrumentation-prompt-api": "workspace:*",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:"
  },
  "devDependencies": {
    "@types/chrome": "catalog:",
    "fake-indexeddb": "catalog:",
    "vitest": "catalog:"
  }
}
