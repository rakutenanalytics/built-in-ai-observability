{
  "name": "@web-ai-otel/devtools-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome DevTools extension for zero-code Built-in AI tracing",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:",
    "@web-ai-otel/core": "workspace:*",
    "@web-ai-otel/extension-transport": "workspace:*",
    "@web-ai-otel/instrumentation-prompt-api": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "catalog:",
    "fake-indexeddb": "catalog:",
    "vitest": "catalog:"
  }
}
