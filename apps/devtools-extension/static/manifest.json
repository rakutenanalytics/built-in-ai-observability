{
  "manifest_version": 3,
  "name": "Built-in AI Traces",
  "version": "0.1.0",
  "description": "Zero-code observability for Chrome Built-in AI APIs",
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
