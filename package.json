{
  "name": "built-in-ai-observability",
  "private": true,
  "description": "OpenTelemetry instrumentation for Built-in AI APIs",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "build:extension": "turbo run build --filter=@web-ai-otel/devtools-extension",
    "build:playground": "turbo run build --filter=@web-ai-otel/playground",
    "build:vanilla": "turbo run build --filter=@web-ai-otel/example-vanilla",
    "check": "biome check .",
    "dev": "turbo run dev",
    "dev:extension": "turbo run dev --filter=@web-ai-otel/devtools-extension",
    "dev:playground": "turbo run dev --filter=@web-ai-otel/playground",
    "dev:vanilla": "turbo run dev --filter=@web-ai-otel/example-vanilla",
    "format": "biome check --write .",
    "mlflow": "uvx mlflow server",
    "precommit": "lefthook run pre-commit",
    "prepare": "lefthook install --reset-hooks-path",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
